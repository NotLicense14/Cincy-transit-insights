{
  "name": "go-metro-insights",
  "version": "0.0.1a",
  "description": "Bluesky bot that turns Go-Metro (Cincinnati) GTFS-realtime bus tracker data into transit visualizations",
  "main": "index.js",
  "dependencies": {
    "@atproto/api": "^0.18.16",
    "axios": "^1.15.0",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.4.7",
    "fs-extra": "^8.1.0",
    "gtfs-realtime-bindings": "^2.0.0",
    "lodash": "^4.18.1",
    "minimist": "^1.2.3",
    "node-gyp": "^13.0.2",
    "rebuild": "^0.1.2",
    "sharp": "^0.34.5"
  },
  "scripts": {
    "bunching": "node bin/bus/bunching.js",
    "bunching:dry": "node bin/bus/bunching.js --dry-run",
    "gaps": "node bin/bus/gaps.js",
    "gaps:dry": "node bin/bus/gaps.js --dry-run",
    "fetch-gtfs": "node scripts/fetch-gtfs.js",
    "fetch-signals": "node scripts/fetch-signals.js",
    "speedmap": "node bin/bus/speedmap.js",
    "speedmap:dry": "node bin/bus/speedmap.js --dry-run",
    "recap": "node bin/bus/recap.js",
    "recap:dry": "node bin/bus/recap.js --dry-run",
    "observe-buses": "node scripts/observeBuses.js",
    "ghosts": "node bin/bus/ghosts.js",
    "ghosts:dry": "node bin/bus/ghosts.js --dry-run",
    "test": "node --test test/*.test.js test/**/*.test.js",
    "export-web": "node bin/export-web.js",
    "publish-data": "sh bin/push-web-data.sh",
    "accessibility": "node bin/accessibility.js",
    "accessibility:dry": "node bin/accessibility.js --dry-run",
    "export-accessibility": "node bin/export-accessibility.js",
    "event-tracks:dry": "node bin/export-event-tracks.js --dry-run",
    "smokeLinux": "for f in bin/bus/*.js; do node \"$f\" --check || exit 1; done",
    "smokeWindows": "for %f in (bin\\bus\\*.js) do node --check \"%f\"",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,json}": "biome check --write --no-errors-on-unmatched"
  },
  "authors": [
    "Cailin Pitt <cailinpitt1@gmail.com> (https://cailinpitt.com)",
    "Anthony Schoenfeldt <antonioschoenfeldt@outlook.com>",
    "Claude AI (https://claude.ai)",
    "ChatGPT (https://chatgpt.com)"
  ],
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "allowScripts": {
    "better-sqlite3@12.9.0": true,
    "sharp@0.34.5": true
  }
}
